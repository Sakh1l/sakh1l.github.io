---
import Nav from "./Nav.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

interface SocialLink {
  href: string;
  icon: string;
  label: string;
  title: string;
  colorClass: string;
}

const socialLinks: SocialLink[] = [
  {
    href: "https://github.com/sakh1l",
    icon: "fa-brands fa-github",
    label: "GitHub",
    title: "Sakhil on GitHub",
    colorClass: "from-primary-yellow to-primary-yellow dark:hover:text-primary-yellow"
  },
  {
    href: "https://twitter.com/",
    icon: "fa-brands fa-twitter",
    label: "Twitter",
    title: "Sakhil on Twitter",
    colorClass: "from-primary-blue to-primary-blue dark:hover:text-primary-blue"
  }
];

const linkBaseClasses = "unset ml-4 rounded-sm transition-[background-size] duration-150 ease-in-out bg-left-bottom bg-[length:0%_55%] hover:bg-[length:100%_55%] bg-no-repeat bg-gradient-to-r dark:bg-none";
---

<header class="">
  <a
    class="unset absolute z-10 left-[50%] -top-[100rem] translate-x-[-50%] bg-white text-black px-8 py-2 focus:top-[initial]"
    href="#main"
  >
    Skip to content
  </a>
  <Nav />
  <div class="justify-self-end py-2 flex items-center content-center text-text-bold">
    {socialLinks.map((link) => (
      <a
        class={`${linkBaseClasses} ${link.colorClass}`}
        href={link.href}
        aria-label={link.label}
      >
        <i class={link.icon} aria-hidden="true" title={link.title}></i>
        <span>{link.label}</span>
      </a>
    ))}
  </div>
  <DarkModeToggle />
</header>
<style>
  header {
    grid-area: header;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(0, max-content) minmax(
        0,
        max-content
      );
  }
</style>
