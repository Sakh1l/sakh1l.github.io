---
type Props = {
  id: string;
};

const { id } = Astro.props;
const elementId = `gist-${id}`;
---

<iframe
  class="gist-iframe"
  width="100%"
  style="border:0;"
  id={elementId}
  data-id={id}
></iframe>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLIFrameElement>(".gist-iframe").forEach((iframe) => {
      const gistId = iframe.dataset.id;
      if (!gistId) return;

      const doc = iframe.contentDocument || iframe.contentWindow?.document;
      if (!doc) return;

      const gistLink = `https://gist.github.com/${gistId}.js`;
      const gistScript = `<script type="text/javascript" src="${gistLink}"><\/script>`;
      const styles = "<style>*{font-size:12px;}</style>";
      const iframeElementId = iframe.id;
      const resizeScript = `onload="parent.document.getElementById('${iframeElementId}').style.height=document.body.scrollHeight + 'px'"`;
      const iframeHtml = `<html><head><base target="_parent">${styles}</head><body ${resizeScript}>${gistScript}</body></html>`;

      doc.open();
      doc.writeln(iframeHtml);
      doc.close();
    });
  });
</script>